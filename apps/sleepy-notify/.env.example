# sleepy-notify environment template.
#
# Copy to either:
#   - `backend/.env`    for local dev (`bun dev` auto-loads it)
#   - `.env.production` for docker compose (see docker-compose.yml)
#
# Authoritative var definitions live in `backend/src/config.ts`.

# --- Required ---
BOT_TOKEN=               # Telegram bot token from @BotFather

# --- Optional (defaults shown) ---
# NODE_ENV=development   # production | test | development
# PORT=3000              # backend HTTP port
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# --- Production only ---
# PUBLIC_DOMAIN=         # e.g. sleepy-notify.la.fish — used to derive API_URL
# API_URL=               # overrides the default https://$PUBLIC_DOMAIN if needed
