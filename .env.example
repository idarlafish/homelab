#!/usr/bin/env bash
# Copy to .env and fill in values — never commit .env
# Source with: source .env

# --- Infrastructure (required for OpenTofu) ---
export TOOLS_SERVER_IP=""

# Cloudflare R2 (OpenTofu remote state backend)
export S3_ACCESS_KEY=""
export S3_SECRET_KEY=""
export AWS_ENDPOINT_URL_S3=""    # https://<cf-account-id>.r2.cloudflarestorage.com

# Hetzner Cloud
export HCLOUD_TOKEN=""
export HCLOUD_SSH_KEY_NAME=""
export GAME_SERVERS_HCLOUD_SSH_KEY_NAME=""

# --- VPN (wg-easy) ---
export WG_EASY_PASSWORD=""    # bcrypt hash

# --- Booklore (MariaDB) ---
export BOOKLORE_MYSQL_ROOT_PASSWORD=""
export BOOKLORE_MYSQL_PASSWORD=""

# --- Cloudflared ---
export CF_TUNNEL_CERT_PATH=""
export CF_TUNNEL_CREDENTIALS_PATH=""

# --- FluxCD ---
export FLUX_TOKEN_PAT=""

# --- Vaultwarden ---
export VAULTWARDEN_OIDC_CLIENT_ID=""
export VAULTWARDEN_OIDC_CLIENT_SECRET=""
